pkgname=project-ember
pkgver=0.1.0.alpha1
pkgrel=2
pkgdesc='Native Qt/Wayland tray and settings utility for Ember'
arch=('x86_64')
url='https://github.com/mariusschober/project-ember'
depends=('qt6-base' 'qt6-wayland' 'wayland' 'systemd')
makedepends=('git' 'cmake' 'ninja' 'pkgconf')
options=('!debug')
_commit=5006691980451169f4fa00f78afab4786edcfcff
source=("project-ember::git+${url}.git#commit=${_commit}")
sha256sums=('SKIP')

# Project Ember currently has no explicit upstream license. Do not label the
# package with an open-source license until the owner makes that decision.

build() {
  cmake -S "${srcdir}/project-ember/linux" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=OFF \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="${pkgdir}" cmake --install build
}
